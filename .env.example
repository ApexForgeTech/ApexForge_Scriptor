# ═══════════════════════════════════════════════════════════════════
#  Obsidian Local AI Agent — Environment Configuration
#  Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════════

# ── Obsidian Vault ───────────────────────────────────────────────────────────
# Absolute path to your Obsidian vault directory.
VAULT_PATH=/home/neo/Documents/Obsidian

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Which AI provider to use: ollama | openai | mistral | gemini | grok | qwen | claude
LLM_PROVIDER=ollama

# ── Ollama (local) ──────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3-vl:2b-instruct
EMBED_MODEL=nomic-embed-text:latest

# ── External AI API Keys ────────────────────────────────────────────────────
# Set the key for whichever provider you selected above.
# Only the active provider's key is required.
OPENAI_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
QWEN_API_KEY=
CLAUDE_API_KEY=

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# Where to persist the vector database on disk.
CHROMA_PERSIST_DIR=./data/chroma

# ── Agent Behaviour ───────────────────────────────────────────────────────────
# How many note chunks to retrieve per query (higher = more context, slower).
RETRIEVAL_TOP_K=6
# Max tokens in a single chunk.
CHUNK_SIZE=512
# Overlap between chunks (for context continuity).
CHUNK_OVERLAP=64

# ── Memory ────────────────────────────────────────────────────────────────────
# How many conversation turns to keep in short-term memory.
MEMORY_WINDOW=10
# Sub-folder inside your vault where the agent stores session summaries.
AGENT_MEMORY_FOLDER=Agent/Memory

# ── Local Time ───────────────────────────────────────────────────────────────
# IANA timezone used for "today", "yesterday", and time questions.
TIMEZONE=Asia/Baku

# ── Permissions ───────────────────────────────────────────────────────────────
# "ask"    → always ask before writing  (recommended)
# "allow"  → allow all writes silently
# "deny"   → never allow writes
WRITE_PERMISSION=ask

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
